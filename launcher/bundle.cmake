set(contents "${BUNDLE}/Contents")
set(macos "${contents}/MacOS")
set(resources "${contents}/Resources")
set(frameworks "${contents}/Frameworks")
file(MAKE_DIRECTORY "${macos}" "${resources}")

function(sign path)
    execute_process(COMMAND codesign --force --sign - "${path}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "codesign failed for ${path}")
    endif()
endfunction()

function(copy_tool src)
    get_filename_component(name "${src}" NAME)
    file(COPY_FILE "${src}" "${macos}/${name}" ONLY_IF_DIFFERENT)
endfunction()

copy_tool("${SA_HOST}")
copy_tool("${SA_VERIFY}")

file(REMOVE_RECURSE "${resources}/manifest")
file(COPY "${MANIFEST_DIR}/" DESTINATION "${resources}/manifest")
file(MAKE_DIRECTORY "${resources}/mods")
file(COPY_FILE "${MOD_SETTINGS_SCHEMA}" "${resources}/mods/settings.yaml" ONLY_IF_DIFFERENT)

if(EXISTS "${ANALYSIS_DIR}/functions.json")
    file(REMOVE_RECURSE "${resources}/analysis")
    file(COPY "${ANALYSIS_DIR}/" DESTINATION "${resources}/analysis")
endif()

if(SA_RECOMP)
    file(MAKE_DIRECTORY "${frameworks}" "${resources}/runtime")
    file(COPY_FILE "${INTRINSICS}" "${resources}/runtime/guest_intrinsics.bc" ONLY_IF_DIFFERENT)
    set(recomp "${macos}/sa-recomp")
    file(COPY_FILE "${SA_RECOMP}" "${recomp}")
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${SA_RECOMP}"
        RESOLVED_DEPENDENCIES_VAR deps
        POST_EXCLUDE_REGEXES "^/usr/lib" "^/System/")
    set(bundled)
    foreach(dep IN LISTS deps)
        file(REAL_PATH "${dep}" real)
        get_filename_component(name "${dep}" NAME)
        if(NOT EXISTS "${frameworks}/${name}" OR "${real}" IS_NEWER_THAN "${frameworks}/${name}")
            file(COPY_FILE "${real}" "${frameworks}/${name}")
            file(CHMOD "${frameworks}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
        endif()
        list(APPEND bundled "${dep}")
    endforeach()
    set(targets "${recomp}")
    foreach(dep IN LISTS bundled)
        get_filename_component(name "${dep}" NAME)
        list(APPEND targets "${frameworks}/${name}")
    endforeach()
    foreach(target IN LISTS targets)
        execute_process(COMMAND otool -L "${target}" OUTPUT_VARIABLE links)
        set(changed FALSE)
        foreach(dep IN LISTS bundled)
            get_filename_component(name "${dep}" NAME)
            string(REGEX MATCHALL "[^\t\n ]*/${name}" refs "${links}")
            foreach(ref IN LISTS refs)
                if(NOT ref MATCHES "^@")
                    if(target MATCHES "/${name}$")
                        execute_process(COMMAND install_name_tool -id "@rpath/${name}" "${target}" ERROR_QUIET)
                    else()
                        execute_process(COMMAND install_name_tool -change "${ref}" "@rpath/${name}" "${target}" ERROR_QUIET)
                    endif()
                    set(changed TRUE)
                endif()
            endforeach()
        endforeach()
        if(target STREQUAL recomp)
            execute_process(COMMAND otool -l "${target}" OUTPUT_VARIABLE commands)
            string(REGEX MATCHALL "path /[^ \n]+" rpaths "${commands}")
            foreach(rpath IN LISTS rpaths)
                string(SUBSTRING "${rpath}" 5 -1 rpath)
                execute_process(COMMAND install_name_tool -delete_rpath "${rpath}" "${target}" ERROR_QUIET)
            endforeach()
            execute_process(COMMAND install_name_tool -add_rpath "@executable_path/../Frameworks" "${target}" ERROR_QUIET)
            set(changed TRUE)
        endif()
        if(changed)
            sign("${target}")
        endif()
    endforeach()
endif()

if(ICON AND EXISTS "${ICON}")
    set(icns "${resources}/AppIcon.icns")
    if(NOT EXISTS "${icns}" OR "${ICON}" IS_NEWER_THAN "${icns}")
        set(iconset "${BUNDLE}/../AppIcon.iconset")
        file(REMOVE_RECURSE "${iconset}")
        file(MAKE_DIRECTORY "${iconset}")
        foreach(size 16 32 128 256 512)
            math(EXPR double "${size} * 2")
            execute_process(COMMAND sips -z ${size} ${size} "${ICON}" --out "${iconset}/icon_${size}x${size}.png" OUTPUT_QUIET)
            execute_process(COMMAND sips -z ${double} ${double} "${ICON}" --out "${iconset}/icon_${size}x${size}@2x.png" OUTPUT_QUIET)
        endforeach()
        execute_process(COMMAND iconutil -c icns "${iconset}" -o "${icns}" RESULT_VARIABLE rc)
        file(REMOVE_RECURSE "${iconset}")
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "iconutil failed for ${ICON}")
        endif()
        execute_process(COMMAND touch "${BUNDLE}")
    endif()
endif()
